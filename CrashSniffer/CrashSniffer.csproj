<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrashSniffer</RootNamespace>
    <AssemblyName>CrashSniffer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>2.5.0</Version>
    <Authors>CrashSniffer</Authors>
    <Product>Windows 系统崩溃诊断与硬件黑匣子工具</Product>
    <Description>深度解析 Minidump 崩溃偏移、聚合 BSOD/WHEA/TDR/LiveKernel/事件日志，免 WinRing0 实时监控 CPU/主板/GPU/全盘传感器并回放崩溃前曲线，支持系统转储体检、一键生成求诊帖及导出含 .dmp 的现代交互式 HTML/ZIP 报告</Description>

    <!-- 体积优化：单文件打包 + 原生库内嵌 + 压缩 + 砍全球化 -->
    <!-- 风险评估：CultureInfo 仅用 InvariantCulture（安全）；无程序集动态加载（安全） -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrashSniffer.Tests" />
  </ItemGroup>

</Project>
